{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lens",
    "checked",
    "findings",
    "summary_ko",
    "not_checked"
  ],
  "properties": {
    "lens": {
      "type": "string",
      "enum": [
        "structure",
        "tests",
        "dependency",
        "feasibility",
        "diagram"
      ],
      "description": "담당 렌즈. 자기 렌즈 밖의 지적은 내지 않는다 (중복 집계 방지)"
    },
    "checked": {
      "type": "array",
      "description": "실제로 확인한 항목과 근거. 확인하지 못한 것은 not_checked 에 남긴다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "result",
          "evidence"
        ],
        "properties": {
          "item": {
            "type": "string",
            "description": "점검 항목"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "n/a"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "파일:라인 또는 실행한 명령과 결과. 추측 금지."
          }
        }
      }
    },
    "not_checked": {
      "type": "array",
      "description": "확인하지 못한 항목과 이유. 없으면 빈 배열.",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "description": "이 렌즈의 지적. 등급 기준은 .agent/docs/review-grading.md. 파일:라인 필수.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "ticket",
          "file",
          "line",
          "problem",
          "fix"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "p0",
              "p1",
              "p2",
              "p3",
              "p4"
            ]
          },
          "ticket": {
            "type": "string",
            "description": "대상 티켓 ID (예: UND-14). 여러 티켓 공통이면 'ALL'"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string",
            "description": "무엇을 어떻게 고칠지 구체적으로"
          }
        }
      }
    },
    "summary_ko": {
      "type": "string"
    }
  }
}
