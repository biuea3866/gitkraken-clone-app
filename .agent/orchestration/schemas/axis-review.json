              "p1",
              "p2",
              "p3",
              "p4"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "false_positive_checked": {
            "type": "boolean",
