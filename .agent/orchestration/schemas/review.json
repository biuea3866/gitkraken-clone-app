{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "ac_results",
    "findings",
    "summary_ko",
    "advisory"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVED",
        "COMMENT",
        "REQUEST_CHANGES"
      ],
      "description": "p0~p2 존재 시 REQUEST_CHANGES, p3~p4 만 COMMENT, 없으면 APPROVED"
    },
    "ac_results": {
      "type": "array",
      "description": "스펙의 인수 조건 항목별 충족 여부와 근거",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "met",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "met": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "description": "파일:라인 또는 테스트명"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "코드 리뷰 지적. 근거 없는 추측 금지 — 파일:라인 필수.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "file",
          "line",
          "problem",
          "fix"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "p0",
              "p1",
              "p2",
              "p3",
              "p4"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "summary_ko": {
      "type": "string"
    },
    "advisory": {
      "type": "array",
      "description": "차단하지 않는 지적. p3~p4 nit 과, 차단 자격이 없어 강등된 항목(review-grading.md C1~C6)을 함께 담는다. 강등 항목은 심각도를 낮추지 않고 non_blocking_reason 을 붙인다 — 기존 p0 를 p4 로 기록하면 후속 티켓에서 위험을 잃는다. 없으면 빈 배열.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "file",
          "line",
          "problem",
          "non_blocking_reason",
          "followup_ko"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "p0",
              "p1",
              "p2",
              "p3",
              "p4"
            ],
            "description": "심각도. 차단하지 않는다고 낮추지 않는다."
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "problem": {
            "type": "string"
          },
          "non_blocking_reason": {
            "type": "string",
            "enum": [
              "none",
              "C1_pre_existing",
              "C2_unachievable",
              "C3_class_closed",
              "C4_decided",
              "C5_artifact",
              "C6_test_depth"
            ],
            "description": "차단 자격을 못 갖춘 사유 (review-grading.md C1~C6). 강등이 아닌 단순 p3~p4 nit 이면 \"none\"."
          },
          "followup_ko": {
            "type": "string",
            "description": "후속 티켓으로 다룰 내용 (C1·C2 에서 권장). 없으면 빈 문자열."
          }
        }
      }
    }
  }
}
